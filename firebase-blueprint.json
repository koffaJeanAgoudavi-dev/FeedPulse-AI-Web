{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with authentication and synchronization settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoUrl": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "preferredLanguage": { "type": "string", "enum": ["fr", "en"] },
        "preferences": { "type": "object", "description": "User topic and calibration preferences" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "Favorite": {
      "title": "Article Favorite",
      "description": "User saved and synchronized AI news briefings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "articleId": { "type": "string", "maxLength": 128 },
        "articleTitle": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 64 },
        "sourceName": { "type": "string", "maxLength": 128 },
        "sourceUrl": { "type": "string", "maxLength": 512 },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "articleId", "articleTitle", "sourceUrl", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document containing preferences and sync status"
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "Collection of briefings and AI news favorited by the user"
    }
  }
}
