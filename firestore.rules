rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoUrl', 'role', 'preferredLanguage', 'preferences', 'createdAt', 'updatedAt']) &&
        data.id == userId &&
        data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512)) &&
        (!('role' in data) || data.role == 'user') &&
        (!('preferredLanguage' in data) || (data.preferredLanguage in ['fr', 'en'])) &&
        (!('preferences' in data) || (data.preferences is map)) &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidFavorite(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'articleId', 'articleTitle', 'sourceUrl', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'articleId', 'articleTitle', 'category', 'sourceName', 'sourceUrl', 'publishedAt', 'createdAt']) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.id is string && data.id.size() <= 128 &&
        data.articleId is string && data.articleId.size() <= 128 &&
        data.articleTitle is string && data.articleTitle.size() <= 256 &&
        data.sourceUrl is string && data.sourceUrl.size() <= 512 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('sourceName' in data) || (data.sourceName is string && data.sourceName.size() <= 128)) &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'preferredLanguage', 'preferences', 'updatedAt']) &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's favorited briefings
      match /favorites/{favoriteId} {
        allow get: if isOwner(userId) && isValidId(favoriteId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId) &&
          incoming().id == favoriteId &&
          isValidFavorite(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(favoriteId) && existing().userId == request.auth.uid;
      }
    }
  }
}
